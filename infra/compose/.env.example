# 複製成 infra/compose/.env，只留在 NAS 上，不要提交。
# 記憶體與 CPU 是容器上限，不是已測量的機器需求。

TZ=Asia/Taipei

KOL_GATE=
KOL_ROLE=viewer
KOL_OPERATOR=
KOL_COOKIE_SECURE=0

# 業務 API 在宿主機的 5210。留空時 Compose 用 http://host.docker.internal:5210
KOL_API=

# 留空則資料放在倉庫下的 data/nas
KOL_NAS_ROOT=

# 預設只聽本機。改成 0.0.0.0 之前，先核對業務 API 自己有沒有認證。
WEB_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
MINIO_BIND=127.0.0.1
MEILI_BIND=127.0.0.1

WEB_MEM_LIMIT=256m
WEB_CPUS=0.50
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=1.00
REDIS_MEM_LIMIT=192m
REDIS_CPUS=0.50
REDIS_MAXMEMORY=128mb
MINIO_MEM_LIMIT=512m
MINIO_CPUS=0.50
MINIO_REGION=us-east-1
MEILI_MEM_LIMIT=512m
MEILI_CPUS=0.50
MEILI_LOG_LEVEL=INFO

POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=kolindex
MINIO_ROOT_PASSWORD=change-me-minio
MEILI_MASTER_KEY=change-me-meili-key

# 下面兩項只給宿主機執行 node tests/dev-server.mjs。
# 網頁容器裡固定為 0，不會讀這裡。
# KOL_DOCKER=1
# KOL_SHERLOCK=1

# 開源候選見 docker-compose.oss.yml。主 Compose 不會啟動它們。
# 監聽位址保持 127.0.0.1。記憶體數字是配額，不是這台機器的測量。
XHS_BIND=127.0.0.1
XHS_PORT=5556
DTK_BIND=127.0.0.1
DTK_PORT=8000
SHERLOCK_MEM_LIMIT=512m
SHERLOCK_CPUS=0.50
MAIGRET_MEM_LIMIT=512m
MAIGRET_CPUS=0.50
XHS_MEM_LIMIT=512m
XHS_CPUS=0.50
DTK_MEM_LIMIT=512m
DTK_CPUS=1.00
